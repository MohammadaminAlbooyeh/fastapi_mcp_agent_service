# Server
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/agent_service
DATABASE_POOL_SIZE=20

# Redis (Cache)
REDIS_URL=redis://localhost:6379/0

# LLM Configuration
LLM_MODEL=claude-3-sonnet-20240229
ANTHROPIC_API_KEY=xxx

# External APIs
OPENAI_API_KEY=xxx
GOOGLE_API_KEY=xxx
SEARCH_API_KEY=xxx

# Security
SECRET_KEY=change-me-in-production
API_KEY=dev-api-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRY=3600

# Notifications
WEBHOOK_URL=

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Celery
# Local/dev default uses Redis. In production, point this at SQS instead,
# e.g. CELERY_BROKER_URL=sqs:// (relying on the task's IAM role for auth).
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# AWS / S3 (file_tool storage)
S3_BUCKET_NAME=
AWS_REGION=us-east-1

# Cost controls
MAX_TOKENS_PER_REQUEST=8000
SEMANTIC_CACHE_SIZE=50
SEMANTIC_CACHE_THRESHOLD=0.95

# Graceful shutdown — should match the ECS task definition's stopTimeout
GRACEFUL_SHUTDOWN_SECONDS=30

# Monitoring
SENTRY_DSN=xxx
